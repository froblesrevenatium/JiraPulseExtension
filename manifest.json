{
  "manifest_version": 3,
  "name": "Jira My Tasks",
  "version": "1.0.0",
  "description": "Muestra tus tareas abiertas de Jira en el badge y popup.",
  "permissions": ["storage", "alarms", "downloads"],
  "host_permissions": ["https://*.atlassian.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_badge_text": "",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
